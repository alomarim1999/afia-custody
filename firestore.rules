rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isManager() { return hasProfile() && profile().role == 'manager'; }
    function canRead() { return hasProfile() && profile().role in ['manager', 'viewer', 'purchaser']; }

    // موظف المشتريات: كل صلاحية يفعّلها المدير له من شاشة الحسابات
    function perm(p) {
      return hasProfile() && profile().role == 'purchaser'
        && profile().get('perms', {}).get(p, false) == true;
    }
    function mine(data) { return data.get('by', '') == request.auth.uid; }

    // الشهر المقفل لا يقبل أي إضافة أو تعديل بتاريخه.
    // شهر فيه رصيد أول المدة فقط ليس له حالة بعد، فهو مفتوح.
    function monthOpen(m) {
      return !exists(/databases/$(database)/documents/months/$(m))
        || get(/databases/$(database)/documents/months/$(m)).data.get('status', 'open') != 'closed';
    }

    // الحسابات: كل شخص يسجّل نفسه "بانتظار الموافقة"، والمدير فقط يغيّر الصلاحيات
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      allow update, delete: if isManager();
    }

    // الفواتير: المدير يسجّل ويسدّد، وموظف المشتريات حسب صلاحياته، والمشاهد يقرأ فقط
    match /invoices/{id} {
      allow read: if canRead();
      allow create: if (isManager() || (perm('addInvoice') && mine(request.resource.data)))
                    && monthOpen(request.resource.data.month)
                    && (request.resource.data.paid != true
                        || ((isManager() || perm('payInvoice')) && monthOpen(request.resource.data.paidMonth)));
      // التعديل الوحيد هو السداد أو إلغاؤه: التاريخ والمورد والمبلغ والمسجِّل لا يتغيّرون
      allow update: if (isManager() || perm('payInvoice'))
                    && request.resource.data.date == resource.data.date
                    && request.resource.data.party == resource.data.party
                    && request.resource.data.amount == resource.data.amount
                    && request.resource.data.get('by', '') == resource.data.get('by', '')
                    && (resource.data.paid != true || monthOpen(resource.data.paidMonth))
                    && (request.resource.data.paid != true || monthOpen(request.resource.data.paidMonth));
      allow delete: if (isManager() || (perm('deleteOwn') && mine(resource.data)))
                    && monthOpen(resource.data.month)
                    && (resource.data.paid != true || monthOpen(resource.data.paidMonth));
    }

    // العهدة المستلمة
    match /receipts/{id} {
      allow read: if canRead();
      allow create: if (isManager() || (perm('addReceipt') && mine(request.resource.data)))
                    && monthOpen(request.resource.data.month);
      allow delete: if (isManager() || (perm('deleteOwn') && mine(resource.data)))
                    && monthOpen(resource.data.month);
    }

    // الأشهر (رصيد أول المدة والإقفال) والإعدادات
    match /months/{m} {
      allow read: if canRead();
      allow write: if isManager();
    }
    match /settings/{d} {
      allow read: if canRead();
      allow write: if isManager();
    }
  }
}
