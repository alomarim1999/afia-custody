rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isManager() { return hasProfile() && profile().role == 'manager'; }
    function canRead() { return hasProfile() && profile().role in ['manager', 'viewer']; }

    // الشهر المقفل لا يقبل أي إضافة أو تعديل بتاريخه
    function monthOpen(m) {
      return !exists(/databases/$(database)/documents/months/$(m))
        || get(/databases/$(database)/documents/months/$(m)).data.status != 'closed';
    }

    // الحسابات: كل شخص يسجّل نفسه "بانتظار الموافقة"، والمدير فقط يغيّر الصلاحيات
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isManager());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'pending';
      allow update, delete: if isManager();
    }

    // الفواتير: المدير يسجّل ويسدّد، والمشاهد يقرأ فقط
    match /invoices/{id} {
      allow read: if canRead();
      allow create: if isManager()
                    && monthOpen(request.resource.data.month)
                    && (request.resource.data.paid != true || monthOpen(request.resource.data.paidMonth));
      // التعديل الوحيد هو السداد أو إلغاؤه: التاريخ والمورد والمبلغ لا يتغيّرون
      allow update: if isManager()
                    && request.resource.data.date == resource.data.date
                    && request.resource.data.party == resource.data.party
                    && request.resource.data.amount == resource.data.amount
                    && (resource.data.paid != true || monthOpen(resource.data.paidMonth))
                    && (request.resource.data.paid != true || monthOpen(request.resource.data.paidMonth));
      allow delete: if isManager()
                    && monthOpen(resource.data.month)
                    && (resource.data.paid != true || monthOpen(resource.data.paidMonth));
    }

    // العهدة المستلمة
    match /receipts/{id} {
      allow read: if canRead();
      allow create: if isManager() && monthOpen(request.resource.data.month);
      allow delete: if isManager() && monthOpen(resource.data.month);
    }

    // الأشهر (رصيد أول المدة والإقفال) والإعدادات
    match /months/{m} {
      allow read: if canRead();
      allow write: if isManager();
    }
    match /settings/{d} {
      allow read: if canRead();
      allow write: if isManager();
    }
  }
}
